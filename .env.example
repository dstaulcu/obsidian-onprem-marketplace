# Copy to .env (gitignored) and fill in. docker compose reads .env automatically; nothing here is committed.
# Leave a value empty to leave the feature off.

# Secrets passed into the admin container as environment variables
GITHUB_TOKEN=
# Used by the separate reviewer container only (the admin container never receives it)
ANTHROPIC_API_KEY=
SPLUNK_HEC_TOKEN=

# Log retention (see docs/admin.md)
OM_ACCESS_LOG_DAYS=14
OM_AUDIT_LOG_DAYS=14
OM_LOG_MAX_SIZE=50M

# Linux hosts only: run the admin as your own user so files in ./registry-data stay editable by you
# OM_UID=1000
# OM_GID=1000

# Signing key for the optional signer container (docker compose --profile signer): secrets/signing-key.pem, gitignored
