{
  "githubApiBase": "https://api.github.com",
  "tokenEnv": "GITHUB_TOKEN",
  "outDir": "registry",
  "maxVersions": 5,
  "review": {
    "enabled": false,
    "model": "claude-sonnet-5-5",
    "maxBudgetUsd": 0.5,
    "maxReviewsPerRun": 5,
    "signingKeyPath": "keys/signing-key.pem"
  },
  "repos": [
    { "repo": "dstaulcu/test-plugin" },
    { "repo": "dstaulcu/obsidian-tag-registry-client" },
    { "repo": "dstaulcu/obsidian-scheduled-agents" }
  ]
}
